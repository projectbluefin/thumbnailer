# ffmpeg-thumbnailer runtime, NVIDIA variant.
#
# Base: jrottenberg/ffmpeg 9.0-nvidia2404. Despite the name it is the broadest variant
# upstream publishes -- its hwaccel list is vdpau/cuda/vaapi/drm, so it covers NVENC/NVDEC
# on NVIDIA *and* VA-API on AMD and Intel.
#
# Upstream's runtime stage copies only /usr/local out of its builder, so the published
# image ships libva but no VA drivers, and no python3. Both are added here; nothing is
# rebuilt.
FROM docker.io/jrottenberg/ffmpeg:9.0-nvidia2404@sha256:76b1f3212f453945580853cda19f09c61fc08d17502c1cf67473e070c017165d

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get -yqq update \
 && apt-get install -yq --no-install-recommends \
      mesa-va-drivers \
      intel-media-va-driver \
      i965-va-driver \
      libva-drm2 \
      vainfo \
      python3-minimal \
      python3-pil \
 && rm -rf /var/lib/apt/lists/*

# libva must find the distro VA drivers; ffmpeg's own libva lives in /usr/local/lib.
ENV LIBVA_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri

COPY thumbnailer-server.py /usr/libexec/ffmpeg-thumbnailer/thumbnailer-server.py
RUN chmod +x /usr/libexec/ffmpeg-thumbnailer/thumbnailer-server.py

ENTRYPOINT ["/usr/libexec/ffmpeg-thumbnailer/thumbnailer-server.py"]
